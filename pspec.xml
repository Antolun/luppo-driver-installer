<?xml version="1.0" ?>
<!DOCTYPE PISI SYSTEM "https://www.pisilinux.org/projeler/pisi/pisi-spec.dtd">
<PISI>
    <Source>
        <Name>pisidi</Name>
        <Homepage>https://github.com/TeknoAnka/pisidi</Homepage>
        <Packager>
            <Name>Solzic0</Name>
            <Email>solzic0@yandex.com</Email>
        </Packager>
        <License>GPLv3</License>
        <IsA>app:gui</IsA>
        <Summary>PiSi Graphics Driver Installer</Summary>
        <Description>Install Graphics Drivers from PiSi</Description>
    </Source>

    <Package>
        <Name>pisidi</Name>
        <RuntimeDependencies>
            <Dependency>python3</Dependency>
            <Dependency>python3-pyqt6</Dependency>
        </RuntimeDependencies>
        <Files>
            <Path fileType="executable">/usr/bin/pisidi</Path>
            <Path fileType="data">/usr/share/pisidi</Path>
            <Path fileType="data">/usr/share/applications/com.teknoanka.pisidi.desktop</Path>
            <Path fileType="data">/usr/share/icons/hicolor/128x128/apps/pisidi.png</Path>
            <Path fileType="doc">/usr/share/doc/pisidi</Path>
        </Files>
    </Package>

    <History>
        <Update release="1">
            <Date>2026-08-09</Date>
            <Version>1.2.0</Version>
            <Comment>PiSiDi package release</Comment>
            <Name>Solzic0</Name>
            <Email>solzic0@yandex.com</Email>
        </Update>
    </History>
</PISI>
